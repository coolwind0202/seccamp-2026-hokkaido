{
    "image":"ghcr.io/srl-labs/containerlab/devcontainer-dind-slim:sha-5ae5009",
    "forwardPorts": [8080],
    "customizations": {
        "codespaces": {
            "repositories": {
                /* for installing forked slidev as a submodule in slide/ */
                "coolwind0202/slidev": {
                    "permissions": {
                        "contents": "read"
                    }
                }
            }
        }
    },
    "features": {
        // For slidev run
        "ghcr.io/devcontainers/features/node:2": {}
    },
    "runArgs": [
        // For suppressing FRR warnings caused by nofile
        "--ulimit", "nofile=65535:65535"
    ],
    "postCreateCommand": "bash .devcontainer/postCreate.sh"
}